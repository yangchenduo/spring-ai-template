# ============================================================
#  Spring AI Template - Local development environment variables
#
#  Copy to .env (git-ignored). The app imports it automatically:
#  application.yml declares spring.config.import with the optional
#  ./ and ../ locations, so `mvnw` works from the repo root and from
#  the module directory. Real env vars still win over the file.
#  docker/.env is a different file - it feeds docker compose.
#
#  Rule of thumb: only uncomment a line when you have a real value
#  for it. Spring's ${VAR:default} falls back only when the variable
#  is ABSENT - an exported empty value overrides the default with "".
# ============================================================

# ---- Chat: any OpenAI-compatible endpoint (spring.ai.openai.*) ----
# Example - Qwen via the Bailian token plan:
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_CHAT_MODEL=qwen-plus
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# ---- Embedding: independent OpenAI-compatible endpoint ----
# Default: SiliconFlow free BAAI/bge-m3 (1024 dims, 8K-token input).
# Do NOT set spring.ai.openai.embedding.dimensions for bge models - only
# the Qwen/Qwen3-Embedding series accepts that parameter on SiliconFlow.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# MUST equal the embedding model's output dimension and the pgvector table
# width. Switching embedding models = change this + DROP TABLE vector_store
# + re-ingest (the pipeline is idempotent, use the reprocess endpoint).
EMBEDDING_DIMENSIONS=1024

# Keeping embeddings on-prem? Point EMBEDDING_BASE_URL at any local
# OpenAI-compatible /v1 server (Ollama, vLLM, LocalAI) and keep
# EMBEDDING_DIMENSIONS in sync - no profile or code change needed.
