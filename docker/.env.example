# ============================================================
#  Spring AI Template - Environment Variables
#  Copy this file to .env and modify as needed
# ============================================================

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spring_ai

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ============================================================
#  AI Provider - OpenAI (default, required)
# ============================================================
# Your OpenAI API key (or compatible provider)
OPENAI_API_KEY=sk-your-key-here

# Compatible providers: just change base-url and api-key
# DeepSeek:   https://api.deepseek.com
# Qwen:       https://dashscope.aliyuncs.com/compatible-mode
# ZhipuAI:    https://open.bigmodel.cn/api/paas
# Moonshot:   https://api.moonshot.cn
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
#  AI Provider - Ollama (optional, local LLM)
#  Only needed if you want to use local models
# ============================================================
# Start Ollama: docker compose --profile ollama up -d
# Pull models:  docker exec ai-ollama ollama pull qwen2.5:7b
# Activate:     set SPRING_PROFILES_ACTIVE=dev,ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

