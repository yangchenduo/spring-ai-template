# ============================================================
#  Spring AI Template - Environment Variables
#  Copy this file to .env and modify as needed
# ============================================================

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spring_ai

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ============================================================
#  AI providers - two independent OpenAI-compatible endpoints
#  Chat uses OPENAI_*, embedding uses EMBEDDING_*. Both can point at
#  any OpenAI-compatible server; to keep embeddings on-prem, set
#  EMBEDDING_BASE_URL to a local /v1 endpoint (Ollama, vLLM,
#  LocalAI, ...) - no code, profile or image change needed.
# ============================================================
# Chat endpoint. Compatible providers:
#   DeepSeek:   https://api.deepseek.com
#   Qwen:       https://dashscope.aliyuncs.com/compatible-mode/v1
#   ZhipuAI:    https://open.bigmodel.cn/api/paas
#   Moonshot:   https://api.moonshot.cn
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding endpoint. Default: SiliconFlow free BAAI/bge-m3
# (1024 dims, 8K input). Do NOT add a dimensions parameter for bge
# models; the table width comes from EMBEDDING_DIMENSIONS and the two
# must match. Changing the model dimension requires recreating the
# vector_store table and re-ingesting (see the reprocess endpoint).
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# Raw uploaded files (the app container mounts a volume here)
STORAGE_TYPE=local
# STORAGE_ROOT is pinned to /app/data/documents by docker-compose.app.yml

# ============================================================
#  Optional: local Ollama server (on-prem chat and/or embeddings)
# ============================================================
# Start it:    docker compose --profile ollama up -d
# Pull models: docker exec ai-ollama ollama pull bge-m3
# Point the app at it:
#   inside the app container: EMBEDDING_BASE_URL=http://ollama:11434/v1
#   from the host:            EMBEDDING_BASE_URL=http://localhost:11434/v1
#   EMBEDDING_MODEL=bge-m3, EMBEDDING_API_KEY=ollama (Ollama ignores the key)
# bge-m3 also returns 1024 dims, so the existing table keeps working.
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b

